// ========================================
// REPORT MODEL
// ========================================

model Report {
  id         String       @id @default(uuid())

  reporter   User         @relation(fields: [reporterId], references: [id])
  reporterId String

  type       ReportType
  targetId   String       // eventId or ratingId depending on type
  reason     String
  status     ReportStatus @default(PENDING)
  adminNote  String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([type, status])
  @@index([reporterId])
  @@map("reports")
}
